---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

interface SiteProps {
  telephone: string;
  url: string;
  metaImage: string;
}

const siteProps: SiteProps = {
  telephone: "+79022857038",
  url: "https://design.pro",
  metaImage: "https://design.pro/meta-image.jpg",
};

const {
  title = "Графический дизайнер Александр Пенкин | Архангельск и Северодвинск | Полиграфия и Препресс",
  description = "слуги графического дизайнера в Архангельске и Северодвинске. Дизайн и верстка листовок, меню, каталогов. Профессиональная предпечатная подготовка (препресс). Исправление макетов для типографии. Цены от 500 руб.",
  keywords = "",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteProps.url} />
    <meta
      property="og:title"
      content="Александр Пенкин — Дизайн полиграфии и верстка (Архангельск/Северодвинск)"
    />
    <meta
      property="og:description"
      content="Разработка макетов, которые принимают типографии с первого раза. Листовки, буклеты, меню, каталоги. Срочная помощь с файлами."
    />
    <meta
      property="og:image"
      content={siteProps.metaImage}
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "GraphicDesigner", // Или ProfessionalService
        "name": "Александр Пенкин | Графический дизайн",
        "image": siteProps.metaImage,
        "@id": siteProps.url,
        "url": siteProps.url,
        "telephone": siteProps.telephone,
        "priceRange": "500-5000 RUB",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Архангельск",
          "addressRegion": "Архангельская область",
          "addressCountry": "RU"
        },
        "areaServed": [
          {
            "@type": "City",
            "name": "Архангельск"
          },
          {
            "@type": "City",
            "name": "Северодвинск"
          },
          {
            "@type": "City",
            "name": "Новодвинск"
          }
        ],
        "description": "Профессиональная верстка полиграфии, дизайн меню и рекламных материалов. Подготовка макетов к офсетной и цифровой печати."
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-cream text-brown font-sans overflow-x-hidden">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
