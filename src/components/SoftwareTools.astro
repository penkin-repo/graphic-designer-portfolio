---
import { SOFTWARES } from "../data/constants";
import { Cube3D } from "../components/Cube3D";
---

<section class="py-24 bg-brown text-white overflow-hidden relative">
    <div
        class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"
    >
    </div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-12">
            <h2
                class="text-4xl lg:text-5xl font-bold mb-4 ibm-plex-serif-semibold-italic text-sand"
            >
                Мой арсенал
            </h2>
            <p class="text-white/60 mt-2">
                Профессиональный софт для профессиональных задач
            </p>
        </div>

        <div
            class="flex flex-wrap justify-center gap-12 lg:gap-24 perspective-1000"
        >
            {
                SOFTWARES.map((sw) => (
                    <div class="flex flex-col items-center">
                        <Cube3D client:load label={sw.icon} color={sw.color} />
                        <p class="mt-4 font-bold tracking-wide text-sand">
                            {sw.name}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
