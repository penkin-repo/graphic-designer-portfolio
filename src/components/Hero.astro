---
import { Palette } from "lucide-react";
import { HeroContactButton } from "./ContactButton";
import { TiltCard } from "./TiltCard";
import { Image } from "astro:assets";
import heroImage from "../images/hero.png";
---

<section
    class="relative min-h-screen flex items-center justify-center pt-36 pb-24 lg:pt-20 overflow-hidden bg-[#FDFBF7]"
>
    <div
        class="absolute inset-0 w-full h-full pointer-events-none z-[1] opacity-10"
        style={{
            backgroundImage: `url("https://www.transparenttextures.com/patterns/3px-tile.png")`,
        }}
    >
    </div>

    <div
        class="absolute top-1/4 -right-20 w-96 h-96 bg-sand rounded-full mix-blend-multiply filter blur-3xl opacity-50"
    >
    </div>
    <div
        class="absolute -bottom-20 -left-20 w-96 h-96 bg-orange-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50"
    >
    </div>

    <div
        class="container mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center relative z-10"
    >
        <div>
            <div
                class="inline-block px-4 py-1 rounded-full bg-orange-100 text-terracotta font-semibold text-sm mb-6"
            >
                Графический дизайнер: Архангельск &bull; Северодвинск
            </div>

            <h1
                class="text-4xl lg:text-5xl font-bold leading-tight mb-6 ibm-plex-serif-bold"
            >
                Графический дизайн <br class="hidden lg:block" />и&nbsp;<span
                    class="text-terracotta ibm-plex-serif-semibold-italic"
                    >верстка полиграфии</span
                >
                <br class="hidden lg:block" /> в&nbsp;Архангельске
            </h1>

            <p class="text-xl opacity-80 mb-8 max-w-lg">
                Верстка меню, листовок, баннеров и&nbsp;каталогов.
                Профессиональный
                <strong>препресс</strong> и&nbsp;подготовка к&nbsp;печати. Исправляю
                макеты, чтобы их&nbsp;приняли в&nbsp;любой типографии региона.
            </p>

            <div class="flex flex-wrap gap-4">
                <HeroContactButton client:load />
                <a
                    href="/portfolio"
                    class="bg-white border-2 border-sand text-brown text-lg px-8 py-4 rounded-xl font-bold hover:bg-cream transition-all inline-block"
                >
                    Смотреть портфолио
                </a>
            </div>
        </div>

        <!-- 3D Card -->
        <div class="lg:block perspective-1000">
            <TiltCard
                client:load
                className="bg-white p-8 rounded-3xl shadow-2xl border border-orange-100 w-full max-w-md mx-auto transform rotate-6"
            >
                <Image
                    src={heroImage}
                    alt="Александр Пенкин - Дизайн полиграфии и верстка в Архангельске"
                    class="rounded-xl w-full h-64 object-cover mb-6 shadow-inner"
                />
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="font-bold text-xl">Александр</h3>
                        <p class="text-sm text-gray-400">
                            Pre-press&nbsp;/ Верстка
                        </p>
                    </div>
                    <div class="bg-orange-100 p-2 rounded-lg">
                        <Palette className="text-terracotta" client:load />
                    </div>
                </div>
                <div
                    class="h-2 bg-gray-100 rounded-full w-full overflow-hidden"
                >
                    <div class="h-full bg-terracotta w-3/4"></div>
                </div>
                <div
                    class="flex justify-between mt-2 text-xs font-mono text-gray-400"
                >
                    <span>CMYK</span>
                    <span>300&nbsp;DPI</span>
                    <span>BLEEDS OK</span>
                </div>
            </TiltCard>
        </div>
        <!-- end 3D Card -->
    </div>
</section>
