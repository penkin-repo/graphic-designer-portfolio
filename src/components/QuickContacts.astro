---
import { MessageCircle, Mail } from "lucide-react";
import { CONTACTS } from "../data/constants";
---

<section class="py-12 bg-cream border-t border-sand">
    <div
        class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6"
    >
        <div>
            <h3 class="text-2xl font-bold mb-2">Готовы начать?</h3>
            <p class="opacity-60">Напишите мне, обсудим проект за 5 минут</p>
        </div>
        <div class="flex gap-4">
            <a
                href={CONTACTS.telegram}
                class="flex items-center gap-2 bg-[#0088cc] text-white px-6 py-3 rounded-lg hover:bg-[#0077b5] transition-colors"
            >
                <MessageCircle size={20} client:load /> Telegram
            </a>
            <a
                href={`mailto:${CONTACTS.email}`}
                class="flex items-center gap-2 bg-brown text-white px-6 py-3 rounded-lg hover:bg-[#3d312a] transition-colors"
            >
                <Mail size={20} client:load />
                {CONTACTS.email}
            </a>
        </div>
    </div>
</section>
