---
import { ContactButton } from "../components/ContactButton";
---

<header>
    <nav
        id="main-nav"
        class="fixed top-0 w-full z-40 bg-cream/80 backdrop-blur-md border-b border-sand transition-transform duration-500"
    >
        <div
            class="container mx-auto px-6 py-3 md:py-4 flex flex-col md:flex-row justify-between items-center gap-2 md:gap-0"
        >
            <a
                href="/"
                class="text-2xl font-bold tracking-tighter shrink-0 ibm-plex-serif-semibold"
            >
                PENKIN<span class="text-terracotta ibm-plex-serif-semibold">
                    DESIGN</span
                >
            </a>

            <div
                class="flex items-center justify-between w-full md:w-auto md:flex-initial overflow-hidden"
            >
                <div
                    class="flex items-center flex-1 justify-start md:justify-end overflow-hidden"
                >
                    <div
                        class="flex items-center gap-6 overflow-x-auto no-scrollbar py-1 pr-4 -mr-4"
                    >
                        <a
                            href="/portfolio"
                            class="font-bold hover:text-terracotta transition-colors whitespace-nowrap"
                            >Портфолио</a
                        >
                        <a
                            href="/articles"
                            class="font-bold hover:text-terracotta transition-colors whitespace-nowrap"
                            >Статьи</a
                        >
                    </div>
                </div>

                <div class="flex-shrink-0 ml-4">
                    <ContactButton client:load />
                </div>
            </div>
        </div>
    </nav>
</header>

<script is:inline>
    let lastScrollY = window.scrollY;
    let scrollThreshold = 100; // minimum scroll to trigger hide
    let scrollUpTrigger = 0; // accumulated scroll up distance
    const nav = document.getElementById("main-nav");

    window.addEventListener("scroll", () => {
        const currentScrollY = window.scrollY;

        if (currentScrollY > lastScrollY && currentScrollY > scrollThreshold) {
            // Scrolling down - hide
            nav.style.transform = "translateY(-100%)";
            scrollUpTrigger = 0; // Reset up trigger when scrolling down
        } else if (currentScrollY < lastScrollY) {
            // Scrolling up
            scrollUpTrigger += lastScrollY - currentScrollY;

            if (scrollUpTrigger > 50 || currentScrollY < 50) {
                // Show if scrolled up significantly or near top
                nav.style.transform = "translateY(0)";
            }
        }

        lastScrollY = currentScrollY;
    });
</script>
