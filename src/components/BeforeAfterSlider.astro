---
import { Image } from "astro:assets";
// Импортируем типы для картинок, если вы используете TypeScript strict mode
import type { ImageMetadata } from "astro";

interface Props {
    beforeImage: ImageMetadata;
    afterImage: ImageMetadata;
    beforeAlt?: string;
    afterAlt?: string;
}

const {
    beforeImage,
    afterImage,
    beforeAlt = "Before",
    afterAlt = "After",
} = Astro.props;
---

<div
    class="before-after-slider relative w-full h-[400px] md:h-[500px] overflow-hidden rounded-3xl select-none cursor-ew-resize shadow-2xl group"
>
    {/* After Image (Background) */}
    <Image
        src={afterImage}
        alt={afterAlt}
        class="absolute top-0 left-0 w-full h-full object-cover"
        draggable="false"
    />

    {/* Before Image (Foreground - Clipped) */}
    <div
        class="before-image-wrapper absolute top-0 left-0 h-full w-full overflow-hidden"
        style="clip-path: inset(0 50% 0 0);"
    >
        <Image
            src={beforeImage}
            alt={beforeAlt}
            class="absolute top-0 left-0 w-full h-full object-cover max-w-none"
            draggable="false"
        />

        {/* Label Before */}
        <span
            class="absolute top-4 left-4 bg-black/60 text-white px-3 py-1 rounded-md text-sm font-bold backdrop-blur-sm pointer-events-none z-10"
        >
            ДО
        </span>
    </div>

    {/* Slider Handle Divider */}
    <div
        class="slider-handle absolute top-0 bottom-0 w-1 bg-white z-20"
        style="left: 50%;"
    >
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 bg-white rounded-full shadow-lg flex items-center justify-center text-terracotta pointer-events-none"
        >
            {
                /* Замена компонента ArrowLeftRight из lucide-react на чистый SVG.
        Это делает компонент независимым от React.
      */
            }
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-left-right"
            >
                <path d="M8 3 4 7l4 4"></path>
                <path d="M4 7h16"></path>
                <path d="m16 21 4-4-4-4"></path>
                <path d="M20 17H4"></path>
            </svg>
        </div>
    </div>

    {/* Label After */}
    <span
        class="absolute top-4 right-4 bg-terracotta/90 text-white px-3 py-1 rounded-md text-sm font-bold backdrop-blur-sm pointer-events-none"
    >
        ПОСЛЕ
    </span>
</div>

<script>
    // Логика работы слайдера на Vanilla JS
    function initSliders() {
        const sliders = document.querySelectorAll(".before-after-slider");

        sliders.forEach((slider) => {
            const beforeWrapper = slider.querySelector(
                ".before-image-wrapper",
            ) as HTMLElement;
            const handle = slider.querySelector(
                ".slider-handle",
            ) as HTMLElement;

            let isDragging = false;

            const updateSliderPosition = (clientX: number) => {
                const rect = slider.getBoundingClientRect();
                const x = Math.max(
                    0,
                    Math.min(clientX - rect.left, rect.width),
                );
                const percentage = (x / rect.width) * 100;

                if (beforeWrapper && handle) {
                    beforeWrapper.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
                    handle.style.left = `${percentage}%`;
                }
            };

            // Mouse Events
            slider.addEventListener("mousedown", (e) => {
                isDragging = true;
                updateSliderPosition((e as MouseEvent).clientX);
            });

            window.addEventListener("mouseup", () => {
                isDragging = false;
            });

            window.addEventListener("mousemove", (e) => {
                if (!isDragging) return;
                updateSliderPosition(e.clientX);
            });

            // Touch Events
            slider.addEventListener(
                "touchstart",
                (e) => {
                    isDragging = true;
                    updateSliderPosition((e as TouchEvent).touches[0].clientX);
                },
                { passive: true },
            );

            window.addEventListener("touchend", () => {
                isDragging = false;
            });

            window.addEventListener(
                "touchmove",
                (e) => {
                    if (!isDragging) return;
                    updateSliderPosition((e as TouchEvent).touches[0].clientX);
                },
                { passive: false },
            );
        });
    }

    // Запуск скрипта. Поддерживает Astro View Transitions, если они включены.
    initSliders();
    document.addEventListener("astro:after-swap", initSliders);
</script>
