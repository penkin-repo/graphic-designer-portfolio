---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Calendar, ArrowRight } from "lucide-react";
import { Image } from "astro:assets";

const articles = await getCollection("articles");
// Sort by date descending
articles.sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));
---

<Layout title="Статьи и советы | Александр Пенкин">
  <main class="pt-36 pb-24 lg:pt-20 min-h-screen">
    <div class="container mx-auto px-6">
      <!-- Header -->
      <div class="max-w-3xl mb-16">
        <a
        href="/"
        class="mb-8 flex items-center gap-2 text-terracotta font-medium hover:underline inline-flex"
      >
        ← На главную
      </a>
        <h1 class="text-5xl lg:text-6xl font-bold mb-6 ibm-plex-serif-bold">Блог о&nbsp;дизайне и&nbsp;<span class="text-terracotta ibm-plex-serif-semibold-italic">маркетинге</span></h1>
        <p class="opacity-60">Делюсь опытом, рассказываю о&nbsp;технологиях и&nbsp;помогаю бизнесу расти через качественный визуал.</p>
      </div>

      <!-- Articles Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article) => (
          <a href={`/articles/${article.slug}`} class="group">
            <article class="bg-white rounded-3xl overflow-hidden border border-sand shadow-sm hover:shadow-xl transition-all duration-500 h-full flex flex-col">
              <!-- Image Container -->
              <div class="relative h-64 overflow-hidden">
                <Image 
                  src={article.data.image} 
                  alt={article.data.title}
                  width={800}
                  height={500}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                />
                <div class="absolute top-4 left-4">
                  <span class="bg-white/90 backdrop-blur-md text-terracotta text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider border border-sand">
                    {article.data.category}
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="p-8 flex flex-col flex-grow">
                <div class="flex items-center gap-4 text-xs opacity-50 mb-4">
                  <div class="flex items-center gap-1">
                    <Calendar size={14} />
                    {new Date(article.data.publishDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </div>
                </div>
                
                <h2 class="text-2xl font-bold mb-4 group-hover:text-terracotta transition-colors leading-tight">
                  {article.data.title}
                </h2>
                
                <p class="text-gray-600 mb-8 line-clamp-3 leading-relaxed">
                  {article.data.description}
                </p>

                <div class="mt-auto pt-6 border-t border-sand flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <img src={article.data.author.avatar} alt={article.data.author.name} class="w-8 h-8 rounded-full border border-sand" />
                    <span class="text-sm font-medium">{article.data.author.name}</span>
                  </div>
                  <div class="text-terracotta group-hover:translate-x-2 transition-transform">
                    <ArrowRight size={20} />
                  </div>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
      
    </div>
  </main>
</Layout>
