---
import {
    Calendar,
    User,
    Briefcase,
} from "lucide-react";
---

<div class="grid md:grid-cols-3 gap-6 mb-16">
    <div class="bg-white p-6 rounded-2xl border border-sand">
        <div class="flex items-center gap-3 mb-3">
            <div class="bg-orange-100 p-2 rounded-lg">
                <User size={20} className="text-terracotta" client:load />
            </div>
            <h3 class="font-bold text-brown">Клиент</h3>
        </div>
        <p class="text-gray-600">
            {item.client || "Конфиденциально"}
        </p>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-sand">
        <div class="flex items-center gap-3 mb-3">
            <div class="bg-orange-100 p-2 rounded-lg">
                <Calendar size={20} className="text-terracotta" client:load />
            </div>
            <h3 class="font-bold text-brown">Год</h3>
        </div>
        <p class="text-gray-600">{item.year || "2024"}</p>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-sand">
        <div class="flex items-center gap-3 mb-3">
            <div class="bg-orange-100 p-2 rounded-lg">
                <Briefcase size={20} className="text-terracotta" client:load />
            </div>
            <h3 class="font-bold text-brown">Категория</h3>
        </div>
        <p class="text-gray-600">{item.category}</p>
    </div>
</div>
