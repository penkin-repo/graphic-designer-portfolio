---
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
// Импортируем иконки из lucide-react
import { X, ChevronLeft, ChevronRight, Maximize2 } from "lucide-react";

interface ImageMetadata {
    src: string;
    width: number;
    height: number;
    format: string;
    fsPath?: string;
}

interface Props {
    images: ImageMetadata[];
    title: string;
}

const { images, title } = Astro.props;

const optimizedImages = await Promise.all(
    images.map(async (image) => {
        const optimized = await getImage({
            src: image,
            format: "webp",
            quality: 80,
            width: 1920,
            height: undefined,
        });
        return optimized.src;
    }),
);
---

<section class="mb-16 gallery-container">
    <h2 class="text-3xl font-bold mb-8">Галерея проекта</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {
            images.map((image, index) => (
                <div
                    class="group relative cursor-pointer overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 thumbnail-trigger opacity-0 translate-y-4"
                    data-index={index}
                    style={`transition-delay: ${index * 100}ms`}
                >
                    <Image
                        src={image}
                        alt={`${title} - изображение ${index + 1}`}
                        width={600}
                        class="w-full h-64 object-cover transform group-hover:scale-110 transition-transform duration-700"
                    />

                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                        <div class="bg-white/20 backdrop-blur-md p-3 rounded-full border border-white/30 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                            <Maximize2 className="text-white w-6 h-6" />
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <div
        id="lightbox"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-sm p-4 md:p-10 opacity-0 transition-opacity duration-300"
        role="dialog"
        aria-modal="true"
    >
        <button
            id="close-btn"
            class="absolute top-6 right-6 z-[120] bg-white/10 hover:bg-white/20 p-3 rounded-full transition-colors border border-white/20 cursor-pointer group"
        >
            <X
                className="text-white w-6 h-6 group-hover:scale-110 transition-transform"
            />
        </button>

        <button
            id="prev-btn"
            class="absolute left-4 top-1/2 -translate-y-1/2 md:left-8 z-[120] bg-white/10 hover:bg-white/20 p-4 rounded-full transition-colors border border-white/20 hidden md:block cursor-pointer group"
        >
            <ChevronLeft
                className="text-white w-8 h-8 group-hover:-translate-x-1 transition-transform"
            />
        </button>

        <button
            id="next-btn"
            class="absolute right-4 top-1/2 -translate-y-1/2 md:right-8 z-[120] bg-white/10 hover:bg-white/20 p-4 rounded-full transition-colors border border-white/20 hidden md:block cursor-pointer group"
        >
            <ChevronRight
                className="text-white w-8 h-8 group-hover:translate-x-1 transition-transform"
            />
        </button>

        <div
            class="relative w-full h-full flex flex-col items-center justify-center pointer-events-none"
        >
            <div
                id="image-loader"
                class="absolute inset-0 flex items-center justify-center z-0"
            >
                <div
                    class="w-12 h-12 border-4 border-white/10 border-t-white rounded-full animate-spin"
                >
                </div>
            </div>

            <img
                id="lightbox-img"
                src=""
                alt="Full view"
                class="relative z-10 max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl transition-all duration-300 pointer-events-auto select-none opacity-0 scale-95"
            />

            <div
                class="mt-6 flex items-center gap-6 pointer-events-auto z-[120]"
            >
                <span id="counter" class="text-white/60 font-medium select-none"
                    >1 / 1</span
                >

                <div class="flex gap-2 md:hidden">
                    <button
                        id="prev-btn-mobile"
                        class="bg-white/10 p-3 rounded-full border border-white/20 text-white active:bg-white/30 transition-colors"
                    >
                        <ChevronLeft className="w-6 h-6" />
                    </button>
                    <button
                        id="next-btn-mobile"
                        class="bg-white/10 p-3 rounded-full border border-white/20 text-white active:bg-white/30 transition-colors"
                    >
                        <ChevronRight className="w-6 h-6" />
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script define:vars={{ galleryImageUrls: optimizedImages }}>
    (function () {
        const triggers = document.querySelectorAll(".thumbnail-trigger");
        const lightbox = document.getElementById("lightbox");
        const lightboxImg = document.getElementById("lightbox-img");
        const closeBtn = document.getElementById("close-btn");
        const prevBtn = document.getElementById("prev-btn");
        const nextBtn = document.getElementById("next-btn");
        const prevBtnMob = document.getElementById("prev-btn-mobile");
        const nextBtnMob = document.getElementById("next-btn-mobile");
        const counter = document.getElementById("counter");

        let currentIndex = null;
        const total = galleryImageUrls.length;

        // --- 1. Intersection Observer ---
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.remove(
                            "opacity-0",
                            "translate-y-4",
                        );
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.1 },
        );
        triggers.forEach((trigger) => observer.observe(trigger));

        // --- 2. Логика Лайтбокса ---
        const preloadNextImage = (index) => {
            const nextIndex = (index + 1) % total;
            const img = new Image();
            img.src = galleryImageUrls[nextIndex];
        };

        const updateImage = () => {
            if (currentIndex === null) return;

            lightboxImg.style.opacity = "0";
            lightboxImg.style.transform = "scale(0.95)";

            const tempImg = new Image();
            const targetSrc = galleryImageUrls[currentIndex];

            tempImg.onload = () => {
                lightboxImg.src = targetSrc;
                counter.textContent = `${currentIndex + 1} / ${total}`;
                lightboxImg.style.opacity = "1";
                lightboxImg.style.transform = "scale(1)";
                preloadNextImage(currentIndex);
            };
            tempImg.src = targetSrc;
        };

        const openLightbox = (index) => {
            currentIndex = index;
            lightbox.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            requestAnimationFrame(() => {
                lightbox.classList.remove("opacity-0");
                updateImage();
            });
        };

        const closeLightbox = () => {
            lightbox.classList.add("opacity-0");
            lightboxImg.style.transform = "scale(0.95)";
            lightboxImg.style.opacity = "0";
            setTimeout(() => {
                lightbox.classList.add("hidden");
                currentIndex = null;
                lightboxImg.src = "";
                document.body.style.overflow = "";
            }, 300);
        };

        const showNext = (e) => {
            e?.stopPropagation();
            if (currentIndex === null) return;
            currentIndex = (currentIndex + 1) % total;
            updateImage();
        };

        const showPrev = (e) => {
            e?.stopPropagation();
            if (currentIndex === null) return;
            currentIndex = (currentIndex - 1 + total) % total;
            updateImage();
        };

        // --- 3. Обработчики ---
        triggers.forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const index = parseInt(trigger.dataset.index);
                openLightbox(index);
            });
        });

        closeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            closeLightbox();
        });

        [nextBtn, nextBtnMob].forEach((btn) =>
            btn?.addEventListener("click", showNext),
        );
        [prevBtn, prevBtnMob].forEach((btn) =>
            btn?.addEventListener("click", showPrev),
        );

        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) closeLightbox();
        });

        document.addEventListener("keydown", (e) => {
            if (currentIndex === null) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowRight") showNext();
            if (e.key === "ArrowLeft") showPrev();
        });
    })();
</script>
