---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ContactButton } from "../../components/ContactButton";
import ImageGalleryAstro from "../../components/ImageGalleryAstro.astro";
import { Image } from "astro:assets";
import {
    ArrowLeft,
    Calendar,
    User,
    Briefcase,
    CheckCircle,
} from "lucide-react";

export async function getStaticPaths() {
    const portfolioEntries = await getCollection("portfolio");
    return portfolioEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { data: item } = entry;
const { Content } = await entry.render();

const allPortfolio = await getCollection("portfolio");
const relatedProjects = allPortfolio
    .filter((p) => p.slug !== entry.slug && p.data.category === item.category)
    .slice(0, 3);

// Prepare all images for the gallery (main image + additional images)
// const allImages = [item.image, ...(item.images || [])];
const allImages = item.images;
---

<Layout
    title={`${item.title} - PENKIN.DESIGN`}
    description={item.fullDescription || item.desc}
>
    <div class="pt-36 pb-24 lg:pt-24 max-w-5xl mx-auto min-h-screen">
        <div class="container mx-auto px-6">
            <!-- Back Button -->
            <a
                href="/portfolio"
                class="inline-flex items-center gap-2 text-terracotta font-medium hover:gap-3 transition-all mb-8"
            >
                <ArrowLeft size={20} client:load /> Назад к портфолио
            </a>

            <!-- Project Header -->
            <div class="mb-12">
                <span
                    class="inline-block px-4 py-1 rounded-full bg-orange-100 text-terracotta font-semibold text-sm mb-4"
                >
                    {item.category}
                </span>
                <h1
                    class="text-5xl lg:text-6xl font-bold mb-6 ibm-plex-serif-bold-italic"
                >
                    {item.title}
                </h1>
                <p class="text-xl opacity-70 max-w-3xl">
                    {item.fullDescription || item.desc}
                </p>
            </div>

            <!-- Main Image (became clickable part of the gallery) -->
            <div class="mb-10 w-fit">
                <div
                    class="relative overflow-hidden max-w-5xl rounded-3xl shadow"
                >
                    <Image
                        src={item.image}
                        alt={item.title}
                        width={1200}
                        height={800}
                        class="max-h-[600px] object-cover"
                    />
                </div>
            </div>

            <!-- Project Info Grid -->
            <div class="grid md:grid-cols-3 gap-4 mb-10 max-w-5xl">
                {/* Клиент */}
                <div
                    class="bg-white p-4 rounded-xl border border-sand flex items-center gap-4"
                >
                    <div class="bg-orange-100 p-2.5 rounded-lg shrink-0">
                        <User
                            size={18}
                            className="text-terracotta"
                            client:load
                        />
                    </div>
                    <div>
                        <h3
                            class="text-xs font-medium text-brown/70 uppercase tracking-wide"
                        >
                            Клиент
                        </h3>
                        <p class="font-semibold text-gray-800 leading-tight">
                            {item.client || "Конфиденциально"}
                        </p>
                    </div>
                </div>

                {/* Год */}
                <div
                    class="bg-white p-4 rounded-xl border border-sand flex items-center gap-4"
                >
                    <div class="bg-orange-100 p-2.5 rounded-lg shrink-0">
                        <Calendar
                            size={18}
                            className="text-terracotta"
                            client:load
                        />
                    </div>
                    <div>
                        <h3
                            class="text-xs font-medium text-brown/70 uppercase tracking-wide"
                        >
                            Год
                        </h3>
                        <p class="font-semibold text-gray-800 leading-tight">
                            {item.year || "2024"}
                        </p>
                    </div>
                </div>

                {/* Категория */}
                <div
                    class="bg-white p-4 rounded-xl border border-sand flex items-center gap-4"
                >
                    <div class="bg-orange-100 p-2.5 rounded-lg shrink-0">
                        <Briefcase
                            size={18}
                            className="text-terracotta"
                            client:load
                        />
                    </div>
                    <div>
                        <h3
                            class="text-xs font-medium text-brown/70 uppercase tracking-wide"
                        >
                            Категория
                        </h3>
                        <p class="font-semibold text-gray-800 leading-tight">
                            {item.category}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Interactive Gallery -->
            <ImageGalleryAstro images={allImages} title={item.title} />

            <!-- Services Provided -->
            {
                item.services && item.services.length > 0 && (
                    <div class="mb-16 max-w-5xl">
                        <h2 class="text-3xl font-bold mb-8">
                            Выполненные работы
                        </h2>
                        <div class="grid md:grid-cols-2 gap-4">
                            {item.services.map((service) => (
                                <div class="flex items-start gap-3 bg-white p-4 rounded-xl border border-sand">
                                    <CheckCircle
                                        size={24}
                                        className="text-terracotta flex-shrink-0 mt-0.5"
                                        client:load
                                    />
                                    <span class="text-brown font-medium">
                                        {service}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Main Content from Markdown -->
            <div class="prose prose-lg prose-stone max-w-none mb-16">
                <Content />
            </div>

            <!-- CTA Section -->
            <div
                class="max-w-5xl bg-gradient-to-r from-terracotta to-orange-400 rounded-3xl p-8 lg:p-12 text-white text-center"
            >
                <h2 class="text-3xl lg:text-4xl font-bold mb-4">
                    Понравился проект?
                </h2>
                <p class="text-lg opacity-90 mb-6 max-w-2xl mx-auto">
                    Создам для вас уникальный дизайн, который выделит ваш бизнес
                    среди конкурентов
                </p>
                <div class="flex justify-center">
                    <ContactButton
                        client:load
                        variant="special"
                        text="Обсудить проект"
                    />
                </div>
            </div>

            <!-- Related Projects -->
            <div class="mt-16">
                {
                    relatedProjects.length > 0 && (
                        <>
                            <h2 class="text-3xl font-bold mb-8">
                                Другие проекты
                            </h2>
                            <div class="grid md:grid-cols-3 gap-8">
                                {relatedProjects.map((relatedEntry) => (
                                    <a
                                        href={`/portfolio/${relatedEntry.slug}`}
                                        class="group"
                                    >
                                        <div class="relative overflow-hidden rounded-2xl shadow-lg">
                                            <Image
                                                src={relatedEntry.data.image}
                                                alt={relatedEntry.data.title}
                                                class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"
                                            />
                                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6 text-white">
                                                <span class="text-orange-300 text-xs font-bold uppercase tracking-wider mb-1">
                                                    {relatedEntry.data.category}
                                                </span>
                                                <h3 class="text-xl font-bold">
                                                    {relatedEntry.data.title}
                                                </h3>
                                                <p class="text-sm opacity-80 mt-1">
                                                    {relatedEntry.data.desc}
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </>
                    )
                }
            </div>
            <!-- end Related Projects -->
        </div>
    </div>
</Layout>
